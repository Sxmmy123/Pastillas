rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /usuarios/{uid} {
      allow read, write: if owns(uid);

      match /registros/{recordId} {
        allow read, write: if owns(uid);
      }
    }
  }
}
